# Public Supabase values for the browser app (safe to expose; RLS + allow-list enforce access).
# Copy to .env.local and fill in. NEVER put a secret / service_role key in any VITE_ variable —
# the app refuses to start with one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Shown in the top bar next to "connected to cloud", e.g. פיתוח
VITE_APP_ENV_LABEL=פיתוח
